{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "InstanceName": "permission-system:"
  },
  "Cache": {
    "Provider": "Memory",
    "EnableRedis": false,
    "DefaultExpirationMinutes": 30,
    "KeyPrefix": "PermissionSystem:"
  },
  "Lock": {
    "DefaultExpirySeconds": 30,
    "DefaultWaitSeconds": 10,
    "RetryDelayMilliseconds": 100,
    "KeyPrefix": "ps:lock:"
  },
  "RabbitMQ": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "permission-system.exchange",
    "RetryCount": 3,
    "RetryIntervalSeconds": 5,
    "ConnectionTimeoutSeconds": 10,
    "EnablePublisherConfirms": true,
    "EnableConsumers": false,
    "EnableOutboxPublisher": false
  },
  "Notifications": {
    "DeliveryMode": "Direct"
  },
  "Hangfire": {
    "SchemaName": "Hangfire",
    "WorkerCount": 20,
    "Queues": [
      "default"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
