{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "OpenIddict": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Tenant": {
    "DefaultTenantId": "10000000-0000-0000-0000-000000000001"
  },
  "Security": {
    "SystemConfigEncryptionKey": ""
  },
  "SeedData": {
    "AdminPassword": "",
    "OAuthClientSecret": ""
  },
  "Redis": {
    "InstanceName": "permission-system:"
  },
  "Cache": {
    "Provider": "Memory",
    "EnableRedis": false,
    "DefaultExpirationMinutes": 30,
    "KeyPrefix": "PermissionSystem:"
  },
  "RateLimit": {
    "Enabled": true,
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RefreshTokenPermitLimit": 20,
    "RefreshTokenWindowSeconds": 60,
    "QueueLimit": 0
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "PermissionSystem.Api",
    "ServiceVersion": "1.0.0",
    "ConsoleExporterEnabled": false,
    "OtlpEndpoint": null,
    "SamplingRatio": 1.0,
    "IncludeSqlStatements": false,
    "IncludeRedisStatements": false
  },
  "Lock": {
    "DefaultExpirySeconds": 30,
    "DefaultWaitSeconds": 10,
    "RetryDelayMilliseconds": 100,
    "KeyPrefix": "ps:lock:"
  },
  "Reports": {
    "SqlReportsEnabled": true,
    "QueryTimeoutSeconds": 30,
    "MaxRows": 1000
  },
  "FileStorage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".pdf",
      ".txt",
      ".csv",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".zip",
      ".rar"
    ],
    "BlockedExtensions": [
      ".exe",
      ".dll",
      ".bat",
      ".cmd",
      ".com",
      ".scr",
      ".msi",
      ".ps1",
      ".sh",
      ".js",
      ".vbs",
      ".jar",
      ".apk"
    ],
    "Local": {
      "RootPath": "uploads",
      "BucketName": "default",
      "PublicBaseUrl": null
    },
    "Minio": {
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "permission-system",
      "UseSsl": false,
      "PublicBaseUrl": null
    }
  },
  "RabbitMQ": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "permission-system.exchange",
    "RetryCount": 3,
    "RetryIntervalSeconds": 5,
    "ConnectionTimeoutSeconds": 10,
    "EnablePublisherConfirms": true,
    "EnableConsumers": false,
    "EnableOutboxPublisher": false
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "SchemaName": "Hangfire",
    "WorkerCount": 20,
    "Queues": [
      "default"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/permission-system-api-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "PermissionSystem.Api"
    }
  }
}
