{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=PermissionSystemDb;User Id=sa;Password=abc123456;Encrypt=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "OpenIddict": {
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Redis": {
    "InstanceName": "permission-system:"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "DefaultExchange": "permission-system",
    "DefaultExchangeType": "topic",
    "Durable": true,
    "AutomaticRecoveryEnabled": true
  },
  "Hangfire": {
    "DashboardPath": "/hangfire",
    "SchemaName": "Hangfire",
    "WorkerCount": 20,
    "Queues": [
      "default"
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/permission-system-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "PermissionSystem.Api"
    }
  }
}
