{
  "AllowedHosts": "",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "OpenIddict": {
    "Issuer": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "ReverseProxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Tenant": {
    "DefaultTenantId": "10000000-0000-0000-0000-000000000001"
  },
  "Security": {
    "SystemConfigEncryptionKey": ""
  },
  "SeedData": {
    "AdminPassword": "",
    "OAuthClientSecret": "",
    "McpIntrospectionClientSecret": ""
  },
  "Ai": {
    "Enabled": false,
    "AllowedTenantIds": [],
    "ConversationRetentionDays": 30,
    "AuditRetentionDays": 180,
    "DraftExpirationMinutes": 30,
    "DraftRetentionDays": 30,
    "EnableReportDatasetTool": false,
    "ApprovedReportDatasetKeys": [],
    "MaxToolRows": 200,
    "OpenAiCompatible": {
      "Enabled": false,
      "BaseUrl": "",
      "ChatCompletionsPath": "v1/chat/completions",
      "ApiKey": "",
      "Model": "",
      "TimeoutSeconds": 30,
      "AllowInsecureHttp": false,
      "AllowPrivateNetwork": false,
      "AllowedHosts": []
    }
  },
  "Redis": {
    "InstanceName": "permission-system:"
  },
  "Cache": {
    "Provider": "Memory",
    "EnableRedis": false,
    "DefaultExpirationMinutes": 30,
    "KeyPrefix": "PermissionSystem:"
  },
  "RateLimit": {
    "Provider": "Memory",
    "Enabled": true,
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "LoginPermitLimit": 5,
    "LoginWindowSeconds": 60,
    "RefreshTokenPermitLimit": 20,
    "RefreshTokenWindowSeconds": 60,
    "ApiKeyWindowSeconds": 60,
    "WebhookPermitLimit": 30,
    "WebhookWindowSeconds": 60,
    "ReportPermitLimit": 30,
    "ReportWindowSeconds": 60
  },
  "OpenTelemetry": {
    "Enabled": true,
    "ServiceName": "PermissionSystem.Api",
    "ServiceVersion": "1.0.0",
    "ConsoleExporterEnabled": false,
    "OtlpEndpoint": null,
    "MetricsEnabled": true,
    "SlowSqlThresholdMilliseconds": 1000,
    "SamplingRatio": 1.0,
    "IncludeSqlStatements": false,
    "IncludeRedisStatements": false
  },
  "Lock": {
    "DefaultExpirySeconds": 30,
    "DefaultWaitSeconds": 10,
    "RetryDelayMilliseconds": 100,
    "KeyPrefix": "ps:lock:"
  },
  "LogArchive": {
    "Enabled": true,
    "ActiveLogDirectory": "logs",
    "ArchiveDirectory": "logs/archive",
    "ActiveRetentionDays": 7,
    "ArchiveRetentionDays": 45,
    "CleanupIntervalMinutes": 60
  },
  "Reports": {
    "SqlReportsEnabled": false,
    "ReportConnection": "",
    "QueryTimeoutSeconds": 30,
    "MaxRows": 1000,
    "MaxConcurrentQueries": 4,
    "Datasets": [
      { "Key": "system-users", "Name": "System users", "ViewName": "reporting.SystemUsers" },
      { "Key": "system-login-logs", "Name": "System login logs", "ViewName": "reporting.SystemLoginLogs" },
      { "Key": "system-operation-logs", "Name": "System operation logs", "ViewName": "reporting.SystemOperationLogs" }
    ]
  },
  "Sso": {
    "Enabled": true,
    "EnableOidc": true,
    "EnableSaml": false,
    "DefaultCallbackPath": "/api/sso/oidc/callback",
    "RequireHttpsMetadata": true,
    "EncryptClientSecret": true,
    "AllowAutoCreateUser": true,
    "AllowLocalLoginFallback": true
  },
  "FileStorage": {
    "Provider": "Local",
    "MaxFileSizeBytes": 20971520,
    "AllowedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".pdf",
      ".txt",
      ".csv",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".pptx",
      ".zip",
      ".rar"
    ],
    "BlockedExtensions": [
      ".exe",
      ".dll",
      ".bat",
      ".cmd",
      ".com",
      ".scr",
      ".msi",
      ".ps1",
      ".sh",
      ".js",
      ".vbs",
      ".jar",
      ".apk"
    ],
    "Local": {
      "RootPath": "uploads",
      "BucketName": "default",
      "PublicBaseUrl": null
    },
    "Minio": {
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "BucketName": "permission-system",
      "UseSsl": false,
      "PublicBaseUrl": null
    }
  },
  "RabbitMQ": {
    "Enabled": false,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "permission-system.exchange",
    "RetryCount": 3,
    "RetryIntervalSeconds": 5,
    "ConnectionTimeoutSeconds": 10,
    "NetworkRecoveryIntervalSeconds": 5,
    "PrefetchCount": 10,
    "ConsumerRetryCount": 3,
    "ConsumerRetryDelaySeconds": 5,
    "PublisherChannelPoolSize": 4,
    "EnablePublisherConfirms": true,
    "EnableConsumers": false,
    "EnableOutboxPublisher": false
  },
  "Notifications": {
    "DeliveryMode": "Direct"
  },
  "Hangfire": {
    "Enabled": true,
    "DashboardEnabled": true,
    "WorkerEnabled": true,
    "DashboardPath": "/hangfire",
    "SchemaName": "Hangfire",
    "WorkerCount": 20,
    "Queues": [
      "default"
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/permission-system-api-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "PermissionSystem.Api"
    }
  }
}
