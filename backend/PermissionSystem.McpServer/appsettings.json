{
  "AllowedHosts": "",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "McpAuthentication": {
    "Authority": "https://localhost:7281/",
    "ResourceUrl": "https://localhost:7071/mcp",
    "IntrospectionClientId": "permission-system-mcp-server",
    "IntrospectionClientSecret": ""
  },
  "Cache": {
    "Provider": "Memory",
    "EnableRedis": false,
    "DefaultExpirationMinutes": 30,
    "KeyPrefix": "PermissionSystem:"
  },
  "RateLimit": {
    "Provider": "Memory",
    "Enabled": true
  },
  "Reports": {
    "SqlReportsEnabled": false,
    "ReportConnection": "",
    "Datasets": []
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "uploads",
      "BucketName": "default"
    }
  },
  "RabbitMQ": {
    "Enabled": false,
    "EnablePublisherConfirms": true,
    "EnableConsumers": false,
    "EnableOutboxPublisher": false
  },
  "Notifications": {
    "DeliveryMode": "Direct"
  },
  "Hangfire": {
    "Enabled": false
  },
  "Ai": {
    "OpenAiCompatible": {
      "Enabled": false,
      "BaseUrl": "",
      "ChatCompletionsPath": "v1/chat/completions",
      "ApiKey": "",
      "Model": "",
      "TimeoutSeconds": 30,
      "AllowInsecureHttp": false,
      "AllowPrivateNetwork": false,
      "AllowedHosts": []
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/permission-system-mcp-.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [TraceId:{TraceId}] {Message:lj}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ],
    "Properties": {
      "Application": "PermissionSystem.McpServer"
    }
  }
}
