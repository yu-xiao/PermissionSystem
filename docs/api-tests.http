# Local dotnet run default: http://localhost:5264
# Docker Compose API port: http://localhost:5000
@host = http://localhost:5264
@apiBaseUrl = {{host}}/api
@connectBaseUrl = {{host}}/connect
@clientId = permission-admin
@clientSecret =
@username = admin
@password =
@scope = openid profile offline_access roles permission-system-api
@pageIndex = 1
@pageSize = 20
@keyword =

### Get token - password grant
# @name token
POST {{connectBaseUrl}}/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{clientId}}&client_secret={{clientSecret}}&username={{username}}&password={{password}}&scope={{scope}}

###
@accessToken = {{token.response.body.$.access_token}}
@refreshToken = {{token.response.body.$.refresh_token}}

### Refresh token
# @name refresh
POST {{connectBaseUrl}}/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id={{clientId}}&client_secret={{clientSecret}}&refresh_token={{refreshToken}}

### Get current user info
GET {{apiBaseUrl}}/me
Authorization: Bearer {{accessToken}}

### Get current user menus
GET {{apiBaseUrl}}/me/menus
Authorization: Bearer {{accessToken}}

### Get current user permission codes
GET {{apiBaseUrl}}/me/permissions
Authorization: Bearer {{accessToken}}

### User paged query
GET {{apiBaseUrl}}/users?pageIndex={{pageIndex}}&pageSize={{pageSize}}&keyword={{keyword}}
Authorization: Bearer {{accessToken}}

### Role paged query
GET {{apiBaseUrl}}/roles?pageIndex={{pageIndex}}&pageSize={{pageSize}}&keyword={{keyword}}
Authorization: Bearer {{accessToken}}

### Menu tree query
GET {{apiBaseUrl}}/menus/tree
Authorization: Bearer {{accessToken}}

### Permission paged query
GET {{apiBaseUrl}}/permissions?pageIndex={{pageIndex}}&pageSize={{pageSize}}&keyword={{keyword}}
Authorization: Bearer {{accessToken}}

### Department tree query
GET {{apiBaseUrl}}/departments/tree
Authorization: Bearer {{accessToken}}

### Tenant paged query
GET {{apiBaseUrl}}/tenants?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Dictionary types paged query
GET {{apiBaseUrl}}/dictionaries/types?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### System config paged query
GET {{apiBaseUrl}}/system-configs?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Operation log paged query
GET {{apiBaseUrl}}/operation-logs?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Login log paged query
GET {{apiBaseUrl}}/login-logs?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Outbox message paged query
GET {{apiBaseUrl}}/outbox-messages?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Inbox message paged query
GET {{apiBaseUrl}}/inbox-messages?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Job paged query
GET {{apiBaseUrl}}/jobs?pageIndex={{pageIndex}}&pageSize={{pageSize}}
Authorization: Bearer {{accessToken}}

### Health summary
GET {{host}}/health

### Health detail
GET {{host}}/health/detail

### Revoke current session
POST {{connectBaseUrl}}/revoke
Authorization: Bearer {{accessToken}}
Content-Type: application/x-www-form-urlencoded

token={{refreshToken}}&token_type_hint=refresh_token&client_id={{clientId}}&client_secret={{clientSecret}}
